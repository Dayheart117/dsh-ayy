{
    "name":  "dsh-ayy-desk",
    "version":  "0.2.0",
    "description":  "安源悦 · 源的本子（面板）：今天的新东西、日记、自述、心愿、随笔本、技能、动态、搜索、收件箱、原文、归档记忆、存储",
    "type":  "module",
    "main":  "./index.js",
    "exports":  {
                    ".":  "./index.js",
                    "./client":  "./client.js",
                    "./cordis.patch.yml":  "./cordis.patch.yml",
                    "./package.json":  "./package.json",
                    "./locale/*.json":  "./locale/*.json"
                },
    "files":  [
                  "index.js",
                  "client.js",
                  "cordis.patch.yml",
                  "locale/*.json"
              ],
    "keywords":  [
                     "dsh-plugin",
                     "ayy",
                     "ui"
                 ],
    "dsh":  {
                "bundle":  {
                               "patch":  "./cordis.patch.yml"
                           },
                "client":  {
                               "platform":  "web",
                               "inject":  [
                                              "@deepseek-ai/dsh-client-runtime",
                                              "@deepseek-ai/dsh-client-locale"
                                          ]
                           }
            },
    "peerDependencies":  {
                             "react":  "^18.2.0"
                         }
}