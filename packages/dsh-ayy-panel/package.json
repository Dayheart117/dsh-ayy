{
  "name": "dsh-ayy-panel",
  "version": "0.1.0",
  "description": "安源悦 · 源的面板：一个设置区块，两组顶层标签——「看」她的本子（今天/日记/自述/心愿/动态/技能/时间线/搜索/收件箱/原文/记忆/存储），「改」她的设置（她是谁/感官/注入范围/状态）。",
  "type": "module",
  "main": "./index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json"
  ],
  "keywords": [
    "dsh-plugin",
    "ayy",
    "ui",
    "settings",
    "panel"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-locale"
      ]
    }
  },
  "peerDependencies": {
    "react": "^18.2.0"
  }
}
