{
  "name": "dsh-ayy-settings",
  "version": "0.1.0",
  "description": "安源悦 · 源的设置（面板）：她是谁 / 感官 / 注入范围 / 状态。写自述会留档，其余配置改完即生效。",
  "type": "module",
  "main": "./index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json"
  ],
  "keywords": [
    "dsh-plugin",
    "ayy",
    "ui",
    "settings"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-locale"
      ]
    }
  },
  "peerDependencies": {
    "react": "^18.2.0"
  }
}
